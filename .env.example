DISCORD_TOKEN=your_discord_bot_token_here

# Your Discord user ID (right-click your name → Copy User ID)
OWNER_ID=your_discord_user_id_here

# Gemini API key for AI-powered replies (get free key at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL connection string (required — get from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Channel ID where moderation actions are logged (optional but recommended)
LOG_CHANNEL_ID=your_log_channel_id_here

# How often task reminders are sent (in DAYS, default 1). Decimals allowed e.g. 0.5 = 12 hours
REMINDER_INTERVAL_DAYS=1

# Uncomment to sync slash commands instantly to a specific guild during development
# GUILD_ID=your_guild_id_here

# ── New feature settings ──────────────────────────────────────────────────────

# Channel ID for the daily brainstorming prompt (cogs/brainstorm.py)
BRAINSTORM_CHANNEL_ID=your_brainstorm_channel_id_here

# Channel ID for #random — witty replies only fire here (cogs/engagement.py)
RANDOM_CHANNEL_ID=your_random_channel_id_here

# Days of inactivity before the bot nudges a user via DM (default: 3)
INACTIVITY_DAYS=3
